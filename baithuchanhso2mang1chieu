#include<bits/stdc++.h>
using namespace std;
int main(){
	int n;
	cout << "Nhap vao so luong phan tu cua mang: " ;
	cin >> n;
	float *p = new float [n];
	cout << "Nhap cac gia tri cho cac phan tu mang: \n";
	for(int i =0; i < n; i++){
		cout<< "a[" << i << "] =";
		cin >> *(p+i); // lay gia tri phan tu trong mang
	}
	cout << "Cac phan tu trong mang la: \n";
	for( int i = 0; i < n; i++){
		cout<< *(p+i) << " ";
	}
	cout << endl;
	return 0;
}
